# job-search-web (015-ai-job-search-watchlist). Read at build time only
# (see Dockerfile) — OpenChoreo's dockerfile-builder has no build-args
# mechanism, so these are committed here rather than passed as ARGs,
# matching insurance-web/.env.production's exact convention.

VITE_API_URL=https://development-analect.apps.oc.analect.com/job-search-api-api

# Must match workload.yaml's endpoints.ui basePath and the Dockerfile's
# nginx COPY destination.
VITE_BASE_PATH=/job-search-web-ui/
